{
  "name": "AHDA21 WordPress DEMO",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "WordPress AHDA21 DEMO",
      "onAutoForward": "notify",
      "requireLocalPort": true
    }
  },
  "postStartCommand": "bash .devcontainer/start-preview.sh"
}
